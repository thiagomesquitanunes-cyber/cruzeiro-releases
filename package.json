{
  "name": "cruzeiro",
  "version": "4.77.6",
  "description": "Gestão financeira pessoal",
  "author": "Cruzeiro",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "publish": "node publish.js",
    "clean-data": "node limpar_dados.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac",
    "build:winstore": "electron-builder --win appx",
    "publish:win": "electron-builder --win --publish always",
    "publish:mac": "electron-builder --mac --publish always"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@stablelib/pbkdf2": "^2.0.1",
    "@stablelib/random": "^2.0.1",
    "@stablelib/sha256": "^2.0.1",
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "electron-updater": "^6.1.7",
    "officecrypto-tool": "^0.0.19",
    "sql.js": "^1.10.3"
  },
  "build": {
    "appId": "com.cruzeiro.app",
    "productName": "Cruzeiro",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Cruzeiro-${version}-portable.exe"
    },
    "appx": {
      "artifactName": "Cruzeiro-${version}.appx",
      "applicationId": "Cruzeiro",
      "displayName": "Cruzeiro",
      "publisherDisplayName": "TODO.PreencherAposReservarNoPartnerCenter",
      "identityName": "TODO.PreencherAposReservarNoPartnerCenter",
      "publisher": "CN=TODO-PREENCHER-APOS-RESERVAR-NO-PARTNER-CENTER",
      "backgroundColor": "#0d3b2e",
      "showNameOnTiles": true,
      "languages": ["pt-BR"]
    },
    "publish": {
      "provider": "github",
      "owner": "thiagomesquitanunes-cyber",
      "repo": "cruzeiro-releases",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/**/*",
      "node_modules/@stablelib/**/*",
      "node_modules/officecrypto-tool/**/*"
    ],
    "nsis": {
      "artifactName": "Cruzeiro-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cruzeiro",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "icon": "assets/icon.ico",
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.finance",
      "artifactName": "Cruzeiro-${version}-${arch}-mac.zip",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    }
  }
}
